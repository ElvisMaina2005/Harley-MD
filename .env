# ==================================================
#           HARLEY-MD BOT CONFIGURATION
# ==================================================
# IMPORTANT: Do not modify the system settings below.
# Scroll to the SESSION CONFIGURATION section and
# paste your SESSION_ID to connect your WhatsApp bot.
# ==================================================


# --------------------------------------------------
# MEDIA API CONFIGURATION — DO NOT EDIT
# --------------------------------------------------
MEDIA_REMOTE_URL=https://harley-md-media-api.onrender.com
MEDIA_REMOTE_KEY=YOUR_MEDIA_REMOTE_KEY
MEDIA_YTDLP_ENABLED=0


# --------------------------------------------------
# AUTOMATIC UPDATE SETTINGS — DO NOT EDIT
# --------------------------------------------------
HARLEY_UPDATE_NOTIFY=1
HARLEY_UPDATE_AUTO_RESTART=0


# --------------------------------------------------
# ANALYTICS CONFIGURATION — DO NOT EDIT
# --------------------------------------------------
ANALYTICS_ENABLED=1
ANALYTICS_API_URL=https://harley-md-analytics-api.onrender.com
ANALYTICS_INSTANCE_ID=YOUR_INSTANCE_ID
ANALYTICS_INSTANCE_TOKEN=YOUR_INSTANCE_TOKEN


# ==================================================
#          WHATSAPP SESSION CONFIGURATION
# ==================================================
# STEP 1: Visit the official Harley-MD pairing site:
# https://harley-md-pair.onrender.com/
#
# STEP 2: Pair your WhatsApp number and copy your
# generated session ID.
#
# STEP 3: Paste your session ID after SESSION_ID=
#
# STEP 4: Save this file and start your bot.
#
# IMPORTANT: Only edit the SESSION_ID field below.
# Do not share your session ID with anyone.
# ==================================================

SESSION_ID=

# ==================================================
#           END OF CONFIGURATION
#              POWERED BY HARLEY-MD
# ==================================================
